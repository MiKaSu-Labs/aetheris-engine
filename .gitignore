# Build output
/build

# Intermediate objects and editor litter
*.o
*.a
*.d
*.obj
*.lib
*.exe

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and local runtime state
*.log
config.json
keys/

# Test suite, fixtures, and docs must stay tracked even if a parent repo
# ignores generic source/data files (e.g. *.json, *.tsv, *.md, tests/,
# test_resources/, docs/).
!tests/
!tests/**
!test_resources/
!test_resources/**
!docs/
!docs/**